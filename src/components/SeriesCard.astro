---
interface Props { series: any; index?: number; }
const { series, index = 0 } = Astro.props;
const { data } = series;
---
<article class="series-card">
  <a href={`/series/${series.id}/`} class="series-card-link">
    <div class="series-card-image-wrap">
      <img src={data.coverImage} alt={data.coverAlt ?? 'Imagem da série'} loading={index < 2 ? 'eager' : 'lazy'} />
    </div>
    <div class="series-card-info">
      <div>
        <span class="eyebrow">Série / galeria</span>
        {data.title && <h2>{data.title}</h2>}
      </div>
      <div class="series-card-meta">
        <span>{data.period ?? 'sem período'}</span>
        <span>{data.works?.length ?? 0} trabalhos</span>
      </div>
    </div>
  </a>
</article>
