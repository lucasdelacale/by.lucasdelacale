---
interface Props {
  item: any;
  kind: 'work' | 'series' | 'text' | 'reference';
  index?: number;
}
const { item, kind, index = 0 } = Astro.props;
const data = item.data;
const title = data.title;
const href = kind === 'work' ? `/acervo/${item.id}/` : kind === 'series' ? `/series/${item.id}/` : kind === 'text' ? `/textos/${item.id}/` : '/referencias/';
const label = kind === 'work' ? data.type ?? 'outro' : kind === 'series' ? 'série' : kind === 'text' ? data.kind ?? 'texto' : data.kind ?? 'referência';
const image = kind === 'work' ? data.coverImage : kind === 'series' ? data.coverImage : kind === 'reference' ? data.image : null;
const alt = kind === 'work' ? data.coverAlt ?? 'Imagem da obra' : kind === 'series' ? data.coverAlt ?? 'Imagem da série' : kind === 'reference' ? data.imageAlt ?? 'Imagem de referência' : '';
---
<article class={`archive-entry archive-entry--${kind} archive-entry--${index % 5}`}>
  <a href={href}>
    {image ? <img src={image} alt={alt} loading={index < 4 ? 'eager' : 'lazy'} /> : <div class="archive-text-mark" aria-hidden="true">“</div>}
    <div class="archive-entry-info">
      <span class="eyebrow">{label}</span>
      {title && <h2>{title}</h2>}
      <p>{kind === 'work' ? data.year ?? 'sem data' : kind === 'series' ? data.period ?? 'sem período' : kind === 'text' ? data.date ?? 'sem data' : data.year ?? 'referência'}</p>
    </div>
  </a>
</article>
