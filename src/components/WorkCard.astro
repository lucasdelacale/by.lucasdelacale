---
interface Props { work: any; index?: number; mode?: 'gallery' | 'mosaic' | 'list'; }
const { work, index = 0, mode = 'gallery' } = Astro.props;
const { data } = work;
const title = data.title;
const type = data.type ?? 'outro';
---
<article class={`work-card work-card--${mode}`} style={`--card-index: ${index}`}>
  <a href={`/acervo/${work.id}/`} class="work-link">
    <div class="work-image-wrap">
      {data.coverImage ? <img src={data.coverImage} alt={data.coverAlt ?? 'Imagem da obra'} loading={index < 3 ? 'eager' : 'lazy'} /> : <div class="work-placeholder" aria-label="Sem imagem">sem imagem</div>}
    </div>
    <div class="work-info">
      {title && <h3>{title}</h3>}
      <p>{type} {data.year ? ` / ${data.year}` : ''}</p>
      {data.series && <p class="muted">{data.series}</p>}
    </div>
  </a>
</article>
