---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import { compareByPublishedAt, sortByPublishedAt } from '../utils/content';

const works = sortByPublishedAt(await getCollection('works'));
const texts = sortByPublishedAt(await getCollection('texts'));
const archive = [
  ...works.map((item) => ({ item, kind: 'work' as const })),
  ...texts.map((item) => ({ item, kind: 'text' as const })),
].sort((a, b) => compareByPublishedAt(a.item, b.item));
---
<BaseLayout title="Arquivo" description="Obras, processos, textos e referências de um acervo artístico em construção.">
  <section class="home-archive" aria-label="Publicações">
    <h1 class="sr-only">Arquivo</h1>
    {archive.length > 0 ? <div class="archive-feed" data-random-publications>{archive.map((entry, index) => <ArchiveEntry item={entry.item} kind={entry.kind} index={index} showTitle={entry.kind === 'text'} />)}</div> : <p class="empty">NENHUM TRABALHO PUBLICADO</p>}
  </section>
</BaseLayout>
<script>
  const publications = document.querySelector<HTMLElement>('[data-random-publications]');

  if (publications) {
    const entries = Array.from(publications.children);

    // Embaralha as entradas
    for (let index = entries.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [entries[index], entries[randomIndex]] = [entries[randomIndex], entries[index]];
    }

    const fragment = document.createDocumentFragment();
    entries.forEach((entry) => fragment.append(entry));
    publications.append(fragment);

    // Scroll infinito: revela entradas conforme aparecem na tela
    const allEntries = Array.from(publications.children);
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '100px', threshold: 0.1 }
    );

    allEntries.forEach((entry, index) => {
      (entry as HTMLElement).style.opacity = '0';
      (entry as HTMLElement).style.transform = 'translateY(20px)';
      (entry as HTMLElement).style.transition = `opacity 0.4s ease ${index * 0.05}s, transform 0.4s ease ${index * 0.05}s`;
      observer.observe(entry);
    });
  }
</script>
