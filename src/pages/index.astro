---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import { compareByPublishedAt, sortByPublishedAt } from '../utils/content';

const works = sortByPublishedAt(await getCollection('works'));
const texts = sortByPublishedAt(await getCollection('texts'));
const featured = works.filter((w) => w.data.featured).slice(0, 3);
const archive = [
  ...works.map((item) => ({ item, kind: 'work' as const })),
  ...texts.map((item) => ({ item, kind: 'text' as const })),
].sort((a, b) => compareByPublishedAt(a.item, b.item));
---
<BaseLayout title="Arquivo" description="Obras, processos, textos e referências de um acervo artístico em construção.">
  <section class="home-archive" aria-label="Publicações">
    <h1 class="sr-only">Arquivo</h1>
    {featured.length > 0 && (
      <div class="featured-section">
        <p class="eyebrow">Destaque</p>
        <div class="featured-grid">
          {featured.map((work, i) => <ArchiveEntry item={work} kind="work" index={i} showTitle={true} />)}
        </div>
      </div>
    )}
    {archive.length > 0 ? <div class="archive-feed" data-random-publications style="visibility:hidden">{archive.map((entry, index) => <ArchiveEntry item={entry.item} kind={entry.kind} index={index} showTitle={entry.kind === 'text'} />)}</div> : <p class="empty">NENHUM TRABALHO PUBLICADO</p>}
  </section>
</BaseLayout>
<script>
  const publications = document.querySelector<HTMLElement>('[data-random-publications]');

  if (publications) {
    const entries = Array.from(publications.children);

    // Embaralha tudo
    for (let index = entries.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [entries[index], entries[randomIndex]] = [entries[randomIndex], entries[index]];
    }

    // Separa obras e textos após embaralhar
    const workEntries = entries.filter((el) => el.classList.contains('archive-entry--work'));
    const textEntries = entries.filter((el) => el.classList.contains('archive-entry--text'));

    // Distribui textos entre as obras (nunca dois textos juntos)
    const finalOrder: Element[] = [];
    if (workEntries.length === 0) {
      if (textEntries.length > 0) finalOrder.push(textEntries[0]);
    } else if (textEntries.length === 0) {
      finalOrder.push(...workEntries);
    } else {
      const frequency = Math.max(1, Math.floor(workEntries.length / (textEntries.length + 1)));
      let textIndex = 0;

      for (let i = 0; i < workEntries.length; i++) {
        finalOrder.push(workEntries[i]);
        if (textIndex < textEntries.length && (i + 1) % frequency === 0) {
          finalOrder.push(textEntries[textIndex]);
          textIndex++;
        }
      }

      while (textIndex < textEntries.length) {
        if (finalOrder[finalOrder.length - 1]?.classList.contains('archive-entry--text') !== true) {
          finalOrder.push(textEntries[textIndex]);
          textIndex++;
        } else {
          break;
        }
      }
    }

    // Reordena no DOM
    publications.innerHTML = '';
    finalOrder.forEach((entry) => publications!.append(entry));

    // Revela o conteúdo após o embaralhamento
    publications.style.visibility = 'visible';

    // Fade-in conforme scroll
    const allEntries = Array.from(publications.children);
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '100px', threshold: 0.1 }
    );

    allEntries.forEach((entry, index) => {
      (entry as HTMLElement).style.opacity = '0';
      (entry as HTMLElement).style.transform = 'translateY(20px)';
      (entry as HTMLElement).style.transition = `opacity 0.4s ease ${index * 0.05}s, transform 0.4s ease ${index * 0.05}s`;
      observer.observe(entry);
    });
  } else {
    // Se não há JS, o conteúdo já está visível (não depende do script)
    const feed = document.querySelector<HTMLElement>('[data-random-publications]');
    if (feed) feed.style.visibility = 'visible';
  }
</script>
<noscript>
  <style>
    [data-random-publications] { visibility: visible !important; }
  </style>
</noscript>
