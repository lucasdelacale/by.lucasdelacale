---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import { compareByPublishedAt, sortByPublishedAt } from '../utils/content';

const works = sortByPublishedAt(await getCollection('works'));
const texts = sortByPublishedAt(await getCollection('texts'));
const books = sortByPublishedAt(await getCollection('books'));
const featured = works.filter((w) => w.data.featured).slice(0, 3);
const archive = [
  ...works.map((item) => ({ item, kind: 'work' as const })),
  ...texts.map((item) => ({ item, kind: 'text' as const })),
  ...books.map((item) => ({ item, kind: 'book' as const })),
].sort((a, b) => compareByPublishedAt(a.item, b.item));
---
<BaseLayout title="Arquivo" description="Obras, processos, textos e referências de um acervo artístico em construção.">
  <section class="home-archive" aria-label="Publicações">
    <h1 class="sr-only">Arquivo</h1>
    {featured.length > 0 && (
      <div class="featured-section">
        <p class="eyebrow">Destaque</p>
        <div class="featured-grid">
          {featured.map((work, i) => <ArchiveEntry item={work} kind="work" index={i} showTitle={true} />)}
        </div>
      </div>
    )}
    {archive.length > 0 ? <div class="archive-feed" data-random-publications style="visibility:hidden">{archive.map((entry, index) => <ArchiveEntry item={entry.item} kind={entry.kind} index={index} imageLoading="lazy" showTitle={entry.kind === 'text' || entry.kind === 'book'} />)}</div> : <p class="empty">NENHUM TRABALHO PUBLICADO</p>}
  </section>
</BaseLayout>
<script>
  const publications = document.querySelector<HTMLElement>('[data-random-publications]');

  if (publications) {
    const entries = Array.from(publications.children);

    // Embaralha tudo
    for (let index = entries.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [entries[index], entries[randomIndex]] = [entries[randomIndex], entries[index]];
    }

    // Separa obras e publicações editoriais após embaralhar
    const workEntries = entries.filter((el) => el.classList.contains('archive-entry--work'));
    const editorialEntries = entries.filter((el) => el.classList.contains('archive-entry--text') || el.classList.contains('archive-entry--book'));

    // Distribui textos e livros entre as obras para manter o feed misturado.
    const finalOrder: Element[] = [];
    if (workEntries.length === 0) {
      finalOrder.push(...editorialEntries);
    } else if (editorialEntries.length === 0) {
      finalOrder.push(...workEntries);
    } else {
      const gapCount = workEntries.length + 1;
      for (let gap = 0; gap < gapCount; gap++) {
        const start = Math.floor((gap * editorialEntries.length) / gapCount);
        const end = Math.floor(((gap + 1) * editorialEntries.length) / gapCount);
        finalOrder.push(...editorialEntries.slice(start, end));
        if (gap < workEntries.length) finalOrder.push(workEntries[gap]);
      }
    }

    // Promove as imagens que ficaram no primeiro plano após o shuffle.
    // Antes, as primeiras imagens eager eram escolhidas na ordem de build,
    // não na ordem aleatória que o visitante realmente via.
    finalOrder.forEach((entry, index) => {
      const image = entry.querySelector<HTMLImageElement>('img');
      if (!image) return;
      image.loading = index < 6 ? 'eager' : 'lazy';
      if (index === 0) image.fetchPriority = 'high';
    });

    // Reordena no DOM
    publications.innerHTML = '';
    finalOrder.forEach((entry) => publications!.append(entry));

    // Revela o conteúdo após o embaralhamento
    publications.style.visibility = 'visible';

    // Fade-in conforme scroll
    const allEntries = Array.from(publications.children);
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target as HTMLElement;
          const image = card.querySelector<HTMLImageElement>('img');
          const reveal = () => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
            observer.unobserve(card);
          };

          if (!image || image.complete) reveal();
          else {
            image.loading = 'eager';
            image.decode().then(reveal).catch(reveal);
          }
        });
      },
      { rootMargin: '900px 0px', threshold: 0.05 }
    );

    allEntries.forEach((entry, index) => {
      (entry as HTMLElement).style.opacity = '0';
      (entry as HTMLElement).style.transform = 'translateY(20px)';
      (entry as HTMLElement).style.transition = `opacity 0.4s ease ${index * 0.05}s, transform 0.4s ease ${index * 0.05}s`;
      observer.observe(entry);
    });
  } else {
    // Se não há JS, o conteúdo já está visível (não depende do script)
    const feed = document.querySelector<HTMLElement>('[data-random-publications]');
    if (feed) feed.style.visibility = 'visible';
  }
</script>
<noscript>
  <style>
    [data-random-publications] { visibility: visible !important; }
  </style>
</noscript>
