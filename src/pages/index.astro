---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import { compareByPublishedAt, sortByPublishedAt } from '../utils/content';

const works = sortByPublishedAt(await getCollection('works'));
const texts = sortByPublishedAt(await getCollection('texts'));

// Distribui textos entre as obras, garantindo que nunca fiquem dois textos juntos
function distributeTexts(works: any[], texts: any[]) {
  if (texts.length === 0) return works.map((item) => ({ item, kind: 'work' as const }));
  if (works.length === 0) return texts.slice(0, 1).map((item) => ({ item, kind: 'text' as const }));

  const result: Array<{ item: any; kind: 'work' | 'text' }> = [];
  const shuffledWorks = [...works].sort(() => Math.random() - 0.5);
  const shuffledTexts = [...texts].sort(() => Math.random() - 0.5);

  // Calcula a frequência ideal: a cada X obras, coloca 1 texto
  const frequency = Math.max(1, Math.floor(shuffledWorks.length / (shuffledTexts.length + 1)));
  let textIndex = 0;
  let workIndex = 0;

  for (let i = 0; i < shuffledWorks.length + shuffledTexts.length && (workIndex < shuffledWorks.length || textIndex < shuffledTexts.length); i++) {
    // Coloca um texto a cada 'frequency' obras, mas nunca dois textos seguidos
    if (textIndex < shuffledTexts.length && workIndex > 0 && workIndex % frequency === 0 && result[result.length - 1]?.kind !== 'text') {
      result.push({ item: shuffledTexts[textIndex], kind: 'text' });
      textIndex++;
    } else if (workIndex < shuffledWorks.length) {
      result.push({ item: shuffledWorks[workIndex], kind: 'work' });
      workIndex++;
    } else if (textIndex < shuffledTexts.length) {
      // Se acabaram as obras, adiciona textos restantes (mas nunca dois seguidos)
      if (result[result.length - 1]?.kind !== 'text') {
        result.push({ item: shuffledTexts[textIndex], kind: 'text' });
        textIndex++;
      }
    }
  }

  return result;
}

const archive = distributeTexts(works, texts);
---
<BaseLayout title="Arquivo" description="Obras, processos, textos e referências de um acervo artístico em construção.">
  <section class="home-archive" aria-label="Publicações">
    <h1 class="sr-only">Arquivo</h1>
    {archive.length > 0 ? <div class="archive-feed">{archive.map((entry, index) => <ArchiveEntry item={entry.item} kind={entry.kind} index={index} showTitle={entry.kind === 'text'} />)}</div> : <p class="empty">NENHUM TRABALHO PUBLICADO</p>}
  </section>
</BaseLayout>
<script>
  const publications = document.querySelector<HTMLElement>('.archive-feed');

  if (publications) {
    // Scroll infinito: revela entradas conforme aparecem na tela
    const allEntries = Array.from(publications.children);
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '100px', threshold: 0.1 }
    );

    allEntries.forEach((entry, index) => {
      (entry as HTMLElement).style.opacity = '0';
      (entry as HTMLElement).style.transform = 'translateY(20px)';
      (entry as HTMLElement).style.transition = `opacity 0.4s ease ${index * 0.05}s, transform 0.4s ease ${index * 0.05}s`;
      observer.observe(entry);
    });
  }
</script>
