---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Mock de obras para a demo — usa imagens reais do public/images
const works = [
  { id: 1, title: 'Sem título', year: 2019, image: '/images/0001.jpeg', x: 120, y: 80 },
  { id: 2, title: 'Sem título', year: 2020, image: '/images/0006.jpg', x: 480, y: 40 },
  { id: 3, title: 'Sem título', year: 2021, image: '/images/0009.png', x: 820, y: 160 },
  { id: 4, title: 'Terrace Culture', year: 2022, image: '/images/0012.jpeg', x: 1180, y: 60 },
  { id: 5, title: 'Sem título', year: 2023, image: '/images/0015.jpg', x: 1540, y: 200 },
  { id: 6, title: 'Sem título', year: 2020, image: '/images/0016.jpeg', x: 200, y: 420 },
  { id: 7, title: 'Sem título', year: 2021, image: '/images/0018.jpeg', x: 560, y: 380 },
  { id: 8, title: 'Sem título', year: 2022, image: '/images/0019.JPG', x: 920, y: 500 },
  { id: 9, title: 'Sem título', year: 2023, image: '/images/0020.JPG', x: 1280, y: 440 },
  { id: 10, title: 'Sem título', year: 2024, image: '/images/0021.jpg', x: 1640, y: 560 },
  { id: 11, title: 'Sem título', year: 2021, image: '/images/0022.jpg', x: 100, y: 760 },
  { id: 12, title: 'Sem título', year: 2022, image: '/images/0023.jpg', x: 460, y: 720 },
  { id: 13, title: 'Sem título', year: 2023, image: '/images/0024.jpg', x: 820, y: 840 },
  { id: 14, title: 'Sem título', year: 2024, image: '/images/0025.jpg', x: 1180, y: 780 },
  { id: 15, title: 'Sem título', year: 2025, image: '/images/0026.jpg', x: 1540, y: 900 },
  { id: 16, title: 'Sem título', year: 2022, image: '/images/0027.jpg', x: 280, y: 1100 },
  { id: 17, title: 'Sem título', year: 2023, image: '/images/0028.jpg', x: 640, y: 1060 },
  { id: 18, title: 'Sem título', year: 2024, image: '/images/0029.jpg', x: 1000, y: 1180 },
  { id: 19, title: 'Sem título', year: 2025, image: '/images/0030.JPG', x: 1360, y: 1120 },
  { id: 20, title: 'Sem título', year: 2026, image: '/images/0031.jpg', x: 1720, y: 1240 },
];

const WORLD_WIDTH = 2000;
const WORLD_HEIGHT = 1500;
const WORK_WIDTH = 280;
const WORK_HEIGHT = 350;
const GAP_X = 80;
const GAP_Y = 60;
---

<BaseLayout title="Demo · Canvas infinito" noIndex={true}>
  <div class="canvas-demo">
    <div class="canvas-viewport" id="viewport">
      <div class="canvas-world" id="world" data-width={WORLD_WIDTH} data-height={WORLD_HEIGHT} style={`width: ${WORLD_WIDTH}px; height: ${WORLD_HEIGHT}px;`}>
        {works.map((work) => (
          <article class="canvas-work" style={`left: ${work.x}px; top: ${work.y}px; width: ${WORK_WIDTH}px;`}>
            <a href={`/acervo/sem-titulo-${work.id}/`} class="canvas-work-link">
              <div class="canvas-work-image">
                <img src={work.image} alt={work.title} loading="lazy" />
              </div>
              <div class="canvas-work-info">
                <span class="canvas-work-label">fotografia</span>
                <h3>{work.title}</h3>
                <p>{work.year}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="canvas-hint" id="canvas-hint">
      <span>Arraste para explorar</span>
    </div>

    <nav class="canvas-nav">
      <a href="/" class="canvas-nav-link">← Voltar para a home</a>
    </nav>
  </div>

  <style>
    .canvas-demo {
      position: fixed;
      inset: 0;
      background: var(--paper);
      z-index: 100;
      overflow: hidden;
    }

    .canvas-viewport {
      width: 100%;
      height: 100%;
      overflow: hidden;
      cursor: default;
      touch-action: none;
    }

    .canvas-world {
      position: absolute;
      top: 0;
      left: 0;
      will-change: transform;
    }

    .canvas-work {
      position: absolute;
    }

    .canvas-work-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .canvas-work-link:hover h3 {
      color: var(--accent);
    }

    .canvas-work-image {
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #d5d4cd;
    }

    .canvas-work-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    .canvas-work-info {
      padding-top: 10px;
      text-align: center;
    }

    .canvas-work-label {
      display: block;
      color: var(--accent);
      font: 10px var(--mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .canvas-work-info h3 {
      font: 300 18px/1.1 var(--serif);
      letter-spacing: -0.02em;
      margin: 4px 0 2px;
      transition: color 0.15s ease;
    }

    .canvas-work-info p {
      color: var(--muted);
      font: 10px var(--mono);
      text-transform: uppercase;
      margin: 0;
    }

    .canvas-hint {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--ink);
      color: white;
      font: 11px var(--mono);
      padding: 10px 20px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      pointer-events: none;
      opacity: 1;
      transition: opacity 0.6s ease;
      z-index: 101;
    }

    .canvas-hint.is-hidden {
      opacity: 0;
    }

    .canvas-nav {
      position: fixed;
      top: 25px;
      left: 4vw;
      z-index: 101;
    }

    .canvas-nav-link {
      font: 12px var(--mono);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink);
      text-decoration: none;
    }

    .canvas-nav-link:hover {
      color: var(--accent);
    }

    @media (max-width: 700px) {
      .canvas-nav {
        left: 5vw;
        top: 20px;
      }

      .canvas-hint {
        bottom: 20px;
        font-size: 10px;
        padding: 8px 16px;
      }
    }
  </style>

  <script>
    const viewport = document.getElementById('viewport')!;
    const world = document.getElementById('world')!;
    const hint = document.getElementById('canvas-hint')!;

    const worldWidth = Number(world.dataset.width) || 2000;
    const worldHeight = Number(world.dataset.height) || 1500;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let translateX = 0;
    let translateY = 0;
    let hasMoved = false;
    let hintTimeout: number;

    // Centraliza o mundo inicialmente para que as obras fiquem visíveis
    function centerWorld() {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      translateX = (vw - worldWidth) / 2;
      translateY = (vh - worldHeight) / 2;
      applyTransform();
    }

    function applyTransform() {
      world.style.transform = `translate(${translateX}px, ${translateY}px)`;
    }

    function getPointerPos(e: MouseEvent | TouchEvent) {
      if ('touches' in e && e.touches.length > 0) {
        return { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
      if ('clientX' in e) {
        return { x: e.clientX, y: e.clientY };
      }
      return { x: 0, y: 0 };
    }

    function onPointerDown(e: MouseEvent | TouchEvent) {
      // Ignora cliques em links
      if ((e.target as HTMLElement).closest('a')) return;

      isDragging = true;
      hasMoved = false;
      const pos = getPointerPos(e);
      startX = pos.x - translateX;
      startY = pos.y - translateY;
      viewport.style.cursor = 'default';
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      e.preventDefault();

      const pos = getPointerPos(e);
      currentX = pos.x - startX;
      currentY = pos.y - startY;

      const dx = Math.abs(currentX - translateX);
      const dy = Math.abs(currentY - translateY);
      if (dx > 5 || dy > 5) hasMoved = true;

      translateX = currentX;
      translateY = currentY;
      applyTransform();

      // Esconde a dica após o primeiro arraste
      if (hasMoved && !hint.classList.contains('is-hidden')) {
        hint.classList.add('is-hidden');
      }
    }

    function onPointerUp() {
      isDragging = false;
    }

    // Mouse events
    viewport.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);

    // Touch events
    viewport.addEventListener('touchstart', onPointerDown, { passive: true });
    viewport.addEventListener('touchmove', onPointerMove, { passive: false });
    viewport.addEventListener('touchend', onPointerUp);

    // Previne o comportamento padrão de arrastar imagens
    viewport.addEventListener('dragstart', (e) => e.preventDefault());

    // Inicializa
    centerWorld();

    // Mostra a dica por 3 segundos
    hintTimeout = window.setTimeout(() => {
      hint.classList.add('is-hidden');
    }, 3000);
  </script>
</BaseLayout>
