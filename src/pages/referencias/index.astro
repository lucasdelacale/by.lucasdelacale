---
import { sitePath } from '../../utils/paths';
const destination = sitePath('/acervo/');
---
<!doctype html>
<html lang="pt-BR">
  <head><meta charset="UTF-8" /><meta http-equiv="refresh" content={`0;url=${destination}`} /><meta name="robots" content="noindex" /><title>Arquivo / Acervo</title></head>
  <body><p>As referências agora fazem parte do <a href={destination}>Arquivo</a>.</p><script is:inline define:vars={{ destination }}>window.location.replace(destination);</script></body>
</html>
