---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import { sortByPublishedAt } from '../../utils/content';
const references = sortByPublishedAt(await getCollection('references'));
---
<BaseLayout title="Referências / Acervo">
  <div class="page">
    <SectionIntro title="Referências" />
    <div class="reference-list">
      {references.map((ref) => { const title = ref.data.title; return <article class="ref-card">{ref.data.image && <img src={ref.data.image} alt={ref.data.imageAlt ?? 'Imagem de referência'} loading="lazy" />}<p class="eyebrow">{ref.data.kind ?? 'referência'}</p>{title && <h2>{title}</h2>}<p class="muted">{ref.data.year ?? 'sem data'}</p></article>; })}
    </div>
  </div>
</BaseLayout>
