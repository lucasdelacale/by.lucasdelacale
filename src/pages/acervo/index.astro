---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import WorkCard from '../../components/WorkCard.astro';
import { sortByPublishedAt, paginate } from '../../utils/content';

const page = Number(Astro.url.searchParams.get('page')) || 1;
const allWorks = sortByPublishedAt(await getCollection('works'));
const { items: works, currentPage, totalPages, hasNext, hasPrev } = paginate(allWorks, page, 24);
---
<BaseLayout title="Arquivo">
  <div class="page">
    <SectionIntro title="Arquivo" />
    {works.length > 0 ? <div class="works-grid" id="works-grid" data-mode="mosaic">{works.map((work, i) => <WorkCard work={work} index={(currentPage - 1) * 24 + i} mode="mosaic" showTitle={false} />)}</div> : <p class="empty" id="empty-state">NENHUM TRABALHO PUBLICADO</p>}
    {totalPages > 1 && (
      <nav class="pagination" aria-label="Navegação de páginas">
        {hasPrev && <a href={`?page=${currentPage - 1}`} class="pagination-link">← Anterior</a>}
        <span class="pagination-info">Página {currentPage} de {totalPages}</span>
        {hasNext && <a href={`?page=${currentPage + 1}`} class="pagination-link">Próxima →</a>}
      </nav>
    )}
  </div>
</BaseLayout>
