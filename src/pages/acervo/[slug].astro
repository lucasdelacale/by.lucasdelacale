---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { sortByPublishedAt } from '../../utils/content';
export async function getStaticPaths() { const works = await getCollection('works'); return works.map((work) => ({ params: { slug: work.id }, props: { work } })); }
const { work } = Astro.props;
const { Content } = await render(work);
const title = work.data.title;
const type = work.data.type ?? 'outro';
const allWorks = sortByPublishedAt(await getCollection('works'));
const related = sortByPublishedAt((work.data.relatedWorks ?? []).map((id) => allWorks.find((item) => item.id === id)).filter((item): item is (typeof allWorks)[number] => Boolean(item)));
const position = allWorks.findIndex((item) => item.id === work.id);
const previous = allWorks[(position - 1 + allWorks.length) % allWorks.length];
const next = allWorks[(position + 1) % allWorks.length];
---
<BaseLayout title={title ? `${title} / Acervo` : 'Obra / Acervo'} description={work.data.coverAlt ?? 'Obra do acervo'}>
  <article class="detail">
    <div class="detail-head"><div><p class="eyebrow">Obra / {type}</p>{title && <h1>{title}</h1>}<p class="muted">{work.data.series ?? 'registro independente'}</p></div><div class="detail-meta"><p><span>Ano</span><strong>{work.data.year ?? '—'}</strong></p><p><span>Materiais</span><strong>{work.data.materials?.join(', ') ?? '—'}</strong></p><p><span>Dimensões</span><strong>{work.data.dimensions ?? '—'}</strong></p><p><span>Tags</span><strong>{work.data.tags?.join(' / ') ?? '—'}</strong></p></div></div>
    {work.data.coverImage ? <img class="detail-image" src={work.data.coverImage} alt={work.data.coverAlt ?? 'Imagem da obra'} /> : <div class="detail-placeholder">Sem imagem para esta obra.</div>}
    <div class="detail-copy prose"><Content /></div>
    {work.data.gallery && <div class="detail-gallery" aria-label="Imagens adicionais">{work.data.gallery.map((image, index) => <button type="button" data-lightbox={image} aria-label={`Ampliar imagem ${index + 2}`}><img src={image} alt={`Vista adicional ${index + 1}`} loading="lazy" /></button>)}</div>}
    {work.data.photoCredit && <p class="caption muted">Fotografia: {work.data.photoCredit}</p>}
    {related.length > 0 && <section class="related"><p class="eyebrow">Continuações</p><div class="related-grid">{related.map((item, i) => <WorkCard work={item} index={i} />)}</div></section>}
    <nav class="detail-nav" aria-label="Navegar entre obras"><a href={`/acervo/${previous.id}/`}>← anterior</a><a href="/acervo/">voltar ao acervo</a><a href={`/acervo/${next.id}/`}>próxima →</a></nav>
  </article>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => button.addEventListener('click', () => { const image = button.querySelector('img'); if (image) window.open(image.src, '_blank', 'noopener'); }));
</script>
