---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { formatPrice, isPurchasable, normalizeContentId, resolveSeriesLabel, sortByPublishedAt } from '../../utils/content';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() { const works = await getCollection('works'); return works.map((work) => ({ params: { slug: work.id }, props: { work } })); }

const { work } = Astro.props;
const { Content } = await render(work);
const title = work.data.title;
const type = work.data.type ?? 'outro';
const allWorks = sortByPublishedAt(await getCollection('works'));
const allSeries = await getCollection('series');
const seriesLabel = resolveSeriesLabel(allSeries, work);
const purchasable = isPurchasable(type);
const sold = Boolean(work.data.sold);
const related = sortByPublishedAt((work.data.relatedWorks ?? []).map((id) => allWorks.find((item) => normalizeContentId(item.id) === normalizeContentId(id))).filter((item): item is (typeof allWorks)[number] => Boolean(item)));
const position = allWorks.findIndex((item) => item.id === work.id);
const previous = allWorks[(position - 1 + allWorks.length) % allWorks.length];
const next = allWorks[(position + 1) % allWorks.length];
const consultHref = `mailto:by.lucasdelacale@gmail.com?subject=${encodeURIComponent(`Consulta sobre ${title ?? work.id}`)}`;
---
<BaseLayout title={title ? `${title} / Acervo` : 'Obra / Acervo'} description={work.data.coverAlt ?? 'Obra do acervo'}>
  <article class="detail">
     <div class="detail-head"><div><p class="eyebrow">Obra / {type}</p>{title && <h1>{title}</h1>}<p class="muted">{seriesLabel ?? 'registro independente'}</p></div><div class="detail-meta"><p><span>Ano</span><strong>{work.data.year ?? '—'}</strong></p><p><span>Materiais</span><strong>{work.data.materials?.join(', ') ?? '—'}</strong></p><p><span>Dimensões</span><strong>{work.data.dimensions ?? '—'}</strong></p><p><span>Tags</span><strong>{work.data.tags?.join(' / ') ?? '—'}</strong></p>{purchasable && <p><span>Preço</span><strong>{work.data.price != null ? formatPrice(work.data.price) : '—'}</strong></p>}{purchasable && <p><span>Status</span><strong class={sold ? 'sale-sold' : undefined}>{sold ? 'Vendida' : work.data.price != null ? 'Disponível' : '—'}</strong></p>}{purchasable && !sold && <p class="detail-cta"><a class="arrow-link" href={consultHref}>Consultar →</a></p>}</div></div>
    <div class="detail-image-wrap">{work.data.coverImage ? <img class="detail-image" src={sitePath(work.data.coverImage)} alt={work.data.coverAlt ?? 'Imagem da obra'} /> : <div class="detail-placeholder">Sem imagem para esta obra.</div>}{sold && <span class="sold-dot" title="Vendida" aria-hidden="true"></span>}</div>
    <div class="detail-copy prose"><Content /></div>
    {work.data.gallery && <div class="detail-gallery" aria-label="Imagens adicionais">{work.data.gallery.map((image, index) => <button type="button" data-lightbox={image} aria-label={`Ampliar imagem ${index + 2}`}><img src={image} alt={`Vista adicional ${index + 1}`} loading="lazy" /></button>)}</div>}
    {work.data.photoCredit && <p class="caption muted">Fotografia: {work.data.photoCredit}</p>}
    {related.length > 0 && <section class="related"><p class="eyebrow">Continuações</p><div class="related-grid">{related.map((item, i) => <WorkCard work={item} index={i} />)}</div></section>}
     <nav class="detail-nav" aria-label="Navegar entre obras"><a href={sitePath(`/acervo/${previous.id}/`)}>← anterior</a><a href={sitePath('/acervo/')}>voltar ao acervo</a><a href={sitePath(`/acervo/${next.id}/`)}>próxima →</a></nav>
  </article>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => button.addEventListener('click', () => { const image = button.querySelector('img'); if (image) window.open(image.src, '_blank', 'noopener'); }));
</script>
