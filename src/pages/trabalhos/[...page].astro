---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import ArchiveEntry from '../../components/ArchiveEntry.astro';
import { isPurchasable, sortByPublishedAt } from '../../utils/content';

export const getStaticPaths = (async ({ paginate }) => {
  const works = sortByPublishedAt((await getCollection('works')).filter((work) => isPurchasable(work.data.type)));
  return paginate(works, { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const filters = [
  { id: 'all', label: 'Todos' },
  { id: 'print', label: 'Prints' },
  { id: 'gravura', label: 'Gravuras' },
  { id: 'canvas', label: 'Canvas' },
  { id: 'escultura', label: 'Esculturas' },
];
---
<BaseLayout title={page.currentPage === 1 ? 'Trabalhos / Acervo' : `Trabalhos — Página ${page.currentPage}`} description="Trabalhos à venda: prints, gravuras, canvas e esculturas.">
  <div class="page">
    <SectionIntro title="Trabalhos" copy="Peças à venda. Prints, gravuras, canvas e esculturas — consulte valor e disponibilidade." />
    {page.data.length > 0 ? (
      <>
        <div class="archive-toolbar">
          <div class="view-switch" role="group" aria-label="Filtrar por tipo">
            {filters.map((filter, index) => (
              <button type="button" data-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>
            ))}
          </div>
        </div>
        <div class="archive-feed" id="trabalhos-grid">
          {page.data.map((work: any, i: number) => <ArchiveEntry item={work} kind="work" index={(page.currentPage - 1) * 24 + i} showSale />)}
        </div>
        {page.url.next && (
          <div class="infinite-scroll-loader" data-infinite-loader data-list-selector="#trabalhos-grid" data-next-url={page.url.next}>
            <p data-infinite-status aria-live="polite">Continue rolando para ver mais trabalhos.</p>
            <button type="button" data-load-more>Carregar mais</button>
            <noscript><a href={page.url.next}>Ver próxima parte dos trabalhos</a></noscript>
          </div>
        )}
      </>
    ) : <p class="empty">Ainda não há trabalhos à venda.</p>}
    {page.data.length > 0 && <p class="empty filter-empty" data-filter-empty hidden>Nenhum trabalho neste filtro.</p>}
  </div>
</BaseLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
  let activeFilter = 'all';

  function applyFilter() {
    const cards = document.querySelectorAll<HTMLElement>('#trabalhos-grid .archive-entry');
    cards.forEach((card) => {
      const type = (card.dataset.workType ?? '').toLowerCase();
      card.hidden = activeFilter !== 'all' && type !== activeFilter;
    });
    const visible = [...cards].some((candidate) => !candidate.hidden);
    emptyState?.toggleAttribute('hidden', visible);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.filter ?? 'all';
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      applyFilter();
    });
  });

  const loader = document.querySelector<HTMLElement>('[data-infinite-loader]');
  const listSelector = loader?.dataset.listSelector;
  const list = listSelector ? document.querySelector<HTMLElement>(listSelector) : null;
  const status = loader?.querySelector<HTMLElement>('[data-infinite-status]');
  const loadButton = loader?.querySelector<HTMLButtonElement>('[data-load-more]');
  let nextUrl = loader?.dataset.nextUrl ?? '';
  let loading = false;
  let observer: IntersectionObserver | null = null;

  async function loadNextBatch() {
    if (!loader || !list || !listSelector || !nextUrl || loading) return;
    loading = true;
    if (loadButton) loadButton.disabled = true;
    if (status) status.textContent = 'Carregando mais trabalhos…';

    try {
      const batchUrl = new URL(nextUrl, window.location.href);
      if (!batchUrl.pathname.endsWith('/')) batchUrl.pathname += '/';
      const response = await fetch(batchUrl);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const nextDocument = new DOMParser().parseFromString(await response.text(), 'text/html');
      const nextList = nextDocument.querySelector<HTMLElement>(listSelector);
      if (!nextList) throw new Error('Lista seguinte não encontrada.');

      const fragment = document.createDocumentFragment();
      const nextEntries = Array.from(nextList.children);
      nextEntries.slice(0, 4).forEach((entry, index) => {
        const image = entry.querySelector<HTMLImageElement>('img');
        if (!image) return;
        image.loading = 'eager';
        if (index === 0) image.fetchPriority = 'high';
      });
      nextEntries.forEach((entry) => fragment.appendChild(entry));
      list.appendChild(fragment);
      applyFilter();

      const nextLoader = nextDocument.querySelector<HTMLElement>('[data-infinite-loader]');
      nextUrl = nextLoader?.dataset.nextUrl ?? '';
      loader.dataset.nextUrl = nextUrl;

      if (!nextUrl) {
        if (status) status.textContent = 'Você chegou ao fim dos trabalhos.';
        loadButton?.remove();
        observer?.disconnect();
      } else if (status) {
        status.textContent = 'Continue rolando para ver mais trabalhos.';
      }
    } catch (error) {
      console.error('Falha ao carregar mais trabalhos:', error);
      if (status) status.textContent = 'Não foi possível carregar agora. Tente novamente.';
      observer?.unobserve(loader);
    } finally {
      loading = false;
      if (loadButton && nextUrl) loadButton.disabled = false;
    }
  }

  loadButton?.addEventListener('click', loadNextBatch);
  if (loader && 'IntersectionObserver' in window) {
    observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) void loadNextBatch();
    }, { rootMargin: '1800px 0px' });
    observer.observe(loader);
  }
</script>
