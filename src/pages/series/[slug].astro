---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { normalizeContentId, sortByPublishedAt } from '../../utils/content';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const series = sortByPublishedAt(await getCollection('series'));
  return series.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const title = item.data.title;
const works = sortByPublishedAt(await getCollection('works'));
const seriesKey = normalizeContentId(item.id);
const selectedItems = (item.data.works ?? [])
  .map((id) => works.find((work) => normalizeContentId(work.id) === normalizeContentId(id)))
  .filter((work): work is (typeof works)[number] => Boolean(work));
const linkedItems = works.filter((work) => normalizeContentId(work.data.series) === seriesKey);
const items = sortByPublishedAt([...selectedItems, ...linkedItems].filter((work, index, all) => all.findIndex((candidate) => candidate.id === work.id) === index));
---
<BaseLayout title={title ? `${title} / Séries` : 'Série / Arquivo'} ogImage={item.data.coverImage}>
  <article class="detail series-detail">
    <header class="detail-head">
      <p class="eyebrow">Série</p>
      {title && <h1 class="series-title">{title}</h1>}
      <p class="series-period">{item.data.period ?? 'sem período'}</p>
    </header>
    <div class="series-cover-wrap">
       {item.data.coverImage && <img class="series-cover" data-series-cover src={sitePath(item.data.coverImage)} alt={item.data.coverAlt ?? 'Imagem da série'} />}
      <div class="series-description prose"><Content /></div>
    </div>
       <section class="series-works" aria-label="Obras da série">
        {items.length > 0 ? <div class="works-grid">{items.map((work, i) => <WorkCard work={work} index={i} minimal />)}</div> : <p class="empty">Esta série ainda não tem obras publicadas.</p>}
    </section>
  </article>
</BaseLayout>
<script>
  const seriesCover = document.querySelector<HTMLImageElement>('[data-series-cover]');
  seriesCover?.addEventListener('load', () => {
    if (seriesCover.naturalWidth > seriesCover.naturalHeight) document.querySelector('.series-detail')?.classList.add('is-landscape');
  });
  if (seriesCover?.complete && seriesCover.naturalWidth > seriesCover.naturalHeight) document.querySelector('.series-detail')?.classList.add('is-landscape');
</script>
