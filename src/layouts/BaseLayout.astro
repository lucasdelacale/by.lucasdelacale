---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitePath } from '../utils/paths';

const { title = 'Arquivo', description = 'Um arquivo vivo de obras, imagens, textos e referências.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={sitePath('/images/0014.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={sitePath('/apple-touch-icon.png')} />
    <link rel="manifest" href={sitePath('/site.webmanifest')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      const preventImageAction = (event: Event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      };

      document.addEventListener('contextmenu', preventImageAction);
      document.addEventListener('dragstart', preventImageAction);
    </script>
  </body>
</html>
